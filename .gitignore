# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.aws_local

# ── Streamlit secrets (never commit — lives on EC2) ───────────────────────────
.streamlit/secrets.toml

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Generated manifests (CLI discovery output) ────────────────────────────────
manifests/*.yaml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Node / React UI (ui/) ─────────────────────────────────────────────────────
node_modules/
ui/dist/
*.tsbuildinfo

# ── SQLite transient journal files (zamboni_local.db itself is tracked) ───────
*.db-shm
*.db-wal

# ── Control-plane DB (SQLite-primary for config tables in production;
# never used for the tracked zamboni_local.db dev fixture) ───────────────────
zamboni_control.db
