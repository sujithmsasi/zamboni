[Unit]
Description=Zamboni API (FastAPI)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/zamboni
EnvironmentFile=/opt/zamboni/.env
Environment=PYTHONPATH=/opt/zamboni
ExecStart=/opt/zamboni/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
