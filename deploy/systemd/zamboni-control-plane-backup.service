[Unit]
Description=Zamboni Control Plane Backup (SQLite VACUUM INTO -> S3)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/zamboni
EnvironmentFile=/opt/zamboni/.env
Environment=PYTHONPATH=/opt/zamboni
ExecStart=/opt/zamboni/.venv/bin/python scripts/control_plane_backup.py
Restart=on-failure
RestartSec=10
# 2026-07-12: file-based so the CloudWatch Agent + weekly logrotate policy
# can pick it up -- both configured by deploy/scripts/configure_logging.sh
# (called from after_install.sh on every deploy, not EC2 UserData -- see
# deploy/systemd/zamboni-api.service's comment for the full rationale).
StandardOutput=append:/var/log/zamboni/control-plane-backup.log
StandardError=append:/var/log/zamboni/control-plane-backup.log

[Install]
WantedBy=multi-user.target
