[Unit]
Description=Zamboni Control Plane Sync (SQLite -> Athena)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/zamboni
EnvironmentFile=/opt/zamboni/.env
Environment=PYTHONPATH=/opt/zamboni
ExecStart=/opt/zamboni/.venv/bin/python scripts/control_plane_sync.py
Restart=on-failure
RestartSec=10
# 2026-07-12: file-based so the CloudWatch Agent + weekly logrotate policy
# can pick it up -- see deploy/zamboni-cfn.yaml's UserData and
# deploy/systemd/zamboni-api.service's comment for the full rationale.
StandardOutput=append:/var/log/zamboni/control-plane-sync.log
StandardError=append:/var/log/zamboni/control-plane-sync.log

[Install]
WantedBy=multi-user.target
