{
  "_comment": "Zamboni EC2 Instance Role Policy. Attach to the IAM role assigned to both dev and prod EC2 instances. Replace ACCOUNT_ID and bucket names with actual values.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AthenaQueryExecution",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:ListQueryExecutions",
        "athena:GetWorkGroup",
        "athena:ListWorkGroups"
      ],
      "Resource": [
        "arn:aws:athena:us-west-2:ACCOUNT_ID:workgroup/zamboni-critical",
        "arn:aws:athena:us-west-2:ACCOUNT_ID:workgroup/zamboni-standard",
        "arn:aws:athena:us-west-2:ACCOUNT_ID:workgroup/zamboni-low",
        "arn:aws:athena:us-west-2:ACCOUNT_ID:workgroup/zamboni-archival",
        "arn:aws:athena:us-west-2:ACCOUNT_ID:workgroup/zamboni-app"
      ]
    },
    {
      "Sid": "S3AthenaResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::your-athena-results-bucket",
        "arn:aws:s3:::your-athena-results-bucket/*"
      ]
    },
    {
      "Sid": "S3StagingReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::your-staging-bucket",
        "arn:aws:s3:::your-staging-bucket/*"
      ]
    },
    {
      "Sid": "S3ArchiveWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::your-archive-bucket",
        "arn:aws:s3:::your-archive-bucket/*"
      ]
    },
    {
      "Sid": "S3ZamboniMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::your-zamboni-metadata-bucket",
        "arn:aws:s3:::your-zamboni-metadata-bucket/*"
      ]
    },
    {
      "Sid": "GlueCatalogRead",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:GetJobRun",
        "glue:GetJobRuns"
      ],
      "Resource": [
        "arn:aws:glue:us-west-2:ACCOUNT_ID:catalog",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:database/*",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:table/*",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:job/*"
      ]
    },
    {
      "Sid": "GlueCatalogDropTableNonProdOnly",
      "Effect": "Allow",
      "Action": [
        "glue:DeleteTable"
      ],
      "Condition": {
        "StringLike": {
          "glue:database": [
            "*_preprod",
            "*_dev",
            "*_test",
            "*_uat"
          ]
        }
      },
      "Resource": [
        "arn:aws:glue:us-west-2:ACCOUNT_ID:catalog",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:database/*_preprod",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:database/*_dev",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:database/*_test",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:database/*_uat",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:table/*_preprod/*",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:table/*_dev/*",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:table/*_test/*",
        "arn:aws:glue:us-west-2:ACCOUNT_ID:table/*_uat/*"
      ]
    },
    {
      "Sid": "SNSPublish",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:sns:us-west-2:ACCOUNT_ID:zamboni-alerts",
        "arn:aws:sns:us-west-2:ACCOUNT_ID:zamboni-greenzone"
      ]
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:us-west-2:ACCOUNT_ID:log-group:/zamboni/*"
      ]
    },
    {
      "Sid": "CloudWatchLogsDescribeGroups",
      "_comment": "logs:DescribeLogGroups has no resource-level permissions -- must be Resource: '*' (see deploy/zamboni-cfn.yaml's matching statement). The CloudWatch Agent's control script calls it internally.",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "Zamboni"
        }
      }
    },
    {
      "Sid": "SSMParameterRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/zamboni/*"
      ]
    },
    {
      "Sid": "CodeDeployAgent",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::aws-codedeploy-us-west-2/*"
      ]
    },
    {
      "Sid": "CostExplorerReadOnly",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostForecast"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}