{
  "_comment": "Zamboni policy templates — applied to tables on registration. All snapshot_min_to_keep values respect the hard floor of 30.",

  "STAGING_DEFAULT": {
    "description": "Default for staging layer — high churn, short retention",
    "compaction_strategy": "binpack",
    "compaction_target_file_size_mb": 128,
    "compaction_engine": "athena",
    "snapshot_retention_days": 3,
    "snapshot_min_to_keep": 30,
    "orphan_file_retention_days": 2,
    "run_frequency": "daily",
    "window_config": {
      "type": "post_batch",
      "timezone": "America/Los_Angeles",
      "delay_minutes": 30,
      "duration_hours": 4,
      "blackout_hours": [6, 7, 8, 9, 18, 19, 20, 21]
    }
  },

  "DATALAKE_DEFAULT": {
    "description": "Default for datalake layer — moderate churn, medium retention",
