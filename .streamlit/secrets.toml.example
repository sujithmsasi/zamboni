# =============================================================================
# Zamboni — Streamlit Secrets (Phase 1 Static Login)
# Copy to .streamlit/secrets.toml on the EC2 instance.
# NEVER commit secrets.toml to git — it is in .gitignore.
#
# Phase 2: Replace with Cognito + ALB authentication.
#          When using ALB+Cognito, this file is no longer needed.
# =============================================================================

[auth]
# Add usernames and passwords here.
# Passwords should be changed from these defaults immediately.
admin   = "change_me_immediately"
sujith  = "change_me_immediately"

[app]
# App display settings
title       = "Zamboni"
subtitle    = "Iceberg Table Governance"
environment = "dev"    # dev | preprod | prod — shown in the UI header
