
# ── Local Mode (no AWS required) ─────────────────────────────────────────────
# Set ZAMBONI_LOCAL_MODE=true to run against a local SQLite database.
# Lets you validate all 12 UI pages without any AWS connectivity.
#
# Setup:
#   python scripts/seed_local_db.py   # create + populate zamboni_local.db
#   streamlit run app/Home.py         # full UI, no AWS needed
#
ZAMBONI_LOCAL_MODE=false
ZAMBONI_LOCAL_DB=zamboni_local.db

# ── Control Plane (SQLite-primary for config/control tables) ─────────────────
# stream_registry/hk_config/domain_registry/nonprod_registry/controlm_jobs
# read/write this file directly, not Athena -- see engine/core/
# control_plane.py. Ignored when ZAMBONI_LOCAL_MODE=true (ZAMBONI_LOCAL_DB is
# used instead). On EC2 this MUST stay an absolute path outside /opt/zamboni
# -- CodeDeploy wipes /opt/zamboni on every revision, and deploy/scripts/
# after_install.sh already provisions /data/zamboni as the persistent home
# for this file. Do not change this to a bare filename in production: that
# would resolve inside /opt/zamboni and the control-plane DB (every
# registered domain/table/policy) would be silently destroyed on the next
# deploy.
ZAMBONI_CONTROL_PLANE_DB=/data/zamboni/zamboni_control.db

# ═══════════════════════════════════════════════════════════════════════════════
# Zamboni — Environment Configuration
# Copy to .env and fill in your actual values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=123456789012

# ── Athena ────────────────────────────────────────────────────────────────────
ATHENA_CATALOG=glue_catalog
ATHENA_DATABASE=zamboni_catalog
ATHENA_RESULTS_BUCKET=s3://your-athena-results-bucket/zamboni/

# ── Athena Workgroups ─────────────────────────────────────────────────────────
ATHENA_WG_CRITICAL=zamboni-critical
ATHENA_WG_STANDARD=zamboni-standard
ATHENA_WG_LOW=zamboni-low
ATHENA_WG_ARCHIVAL=zamboni-archival
ATHENA_WG_APP=zamboni-app

# ── Zamboni Metadata Tables ───────────────────────────────────────────────────
DOMAIN_REGISTRY_TABLE=glue_catalog.zamboni_catalog.domain_registry
STREAM_REGISTRY_TABLE=glue_catalog.zamboni_catalog.stream_registry
HK_CONFIG_TABLE=glue_catalog.zamboni_catalog.hk_config
EXECUTION_LOG_TABLE=glue_catalog.zamboni_catalog.execution_log
NONPROD_REGISTRY_TABLE=glue_catalog.zamboni_catalog.nonprod_registry

# ── S3 Buckets ────────────────────────────────────────────────────────────────
STAGING_BUCKET=s3://your-staging-bucket
ARCHIVE_BUCKET=s3://your-archive-bucket
ZAMBONI_METADATA_BUCKET=s3://your-zamboni-metadata-bucket

# ── SNS ───────────────────────────────────────────────────────────────────────
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-west-2:123456789012:zamboni-alerts
SNS_GREENZONE_TOPIC_ARN=arn:aws:sns:us-west-2:123456789012:zamboni-greenzone

# ── CloudTrail (Lifecycle Engine activity signals) ────────────────────────────
# Optional: if CloudTrail logs are in Athena, set this to enable accurate stale detection.
# Format: glue_catalog.database.table  e.g. glue_catalog.logs_db.cloudtrail_events
CLOUDTRAIL_TABLE=
CLOUDTRAIL_LOOKBACK_DAYS=90

# ── Engine Behaviour ──────────────────────────────────────────────────────────
DRY_RUN_DEFAULT=true
LOG_LEVEL=INFO
MAX_CONCURRENT_PARTITIONS=10
CIRCUIT_BREAKER_THRESHOLD=3

# ── Streamlit App ─────────────────────────────────────────────────────────────
APP_PORT=8501
APP_ENV=dev

# Streamlit telemetry
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
