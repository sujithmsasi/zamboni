# ═══════════════════════════════════════════════════════════════════════════════
# Zamboni — aws_local Environment (laptop demo against REAL AWS, contracts.md D4)
# Copy to .env.aws_local and fill in real values. NEVER commit .env.aws_local.
#
# Loaded by run_aws_local.ps1 / run_ui_dev.ps1 -Mode aws_local. Requires an
# AWS SSO profile already configured (aws configure sso --profile <name>).
# ═══════════════════════════════════════════════════════════════════════════════

# ── Mode (config/settings.py::get_mode(), contracts.md §2) ────────────────────
# aws_local = laptop demo, real AWS via the SSO profile below.
ZAMBONI_MODE=aws_local
# 2026-07-11 fix: this used to default to "prod-toolsgenai-sso" -- a
# cross-team, Bedrock-only profile in at least one org's account that has
# nothing to do with Zamboni's own AWS account. Anyone who copied this file
# without editing this line would point run_aws_local.ps1 at the wrong
# account/identity. The value below matches setup_aws_local_profile.ps1's
# own default profile name -- run that script first (it creates the
# profile interactively, pasting keys from the AWS console or chaining to
# an existing profile) and this line needs no manual edit at all.
#
# Naming convention: name the profile "zamboni-{env}" to match the AWS
# account it points at (zamboni-dev / zamboni-preprod / zamboni-prod),
# and keep APP_ENV below set to the same {env} -- nothing derives one from
# the other automatically, so a mismatch here won't error, it'll just show
# the wrong environment tag in the app header while genuinely talking to
# a different account than the tag claims.
AWS_SSO_PROFILE=zamboni-dev

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=123456789012

# ── Athena ────────────────────────────────────────────────────────────────────
ATHENA_CATALOG=glue_catalog
ATHENA_DATABASE=zamboni_catalog
ATHENA_RESULTS_BUCKET=s3://your-athena-results-bucket/zamboni/

# ── Athena Workgroups ─────────────────────────────────────────────────────────
ATHENA_WG_CRITICAL=zamboni-critical
ATHENA_WG_STANDARD=zamboni-standard
ATHENA_WG_LOW=zamboni-low
ATHENA_WG_ARCHIVAL=zamboni-archival
ATHENA_WG_APP=zamboni-app

# ── Zamboni Metadata Tables ───────────────────────────────────────────────────
DOMAIN_REGISTRY_TABLE=glue_catalog.zamboni_catalog.domain_registry
STREAM_REGISTRY_TABLE=glue_catalog.zamboni_catalog.stream_registry
HK_CONFIG_TABLE=glue_catalog.zamboni_catalog.hk_config
EXECUTION_LOG_TABLE=glue_catalog.zamboni_catalog.execution_log
NONPROD_REGISTRY_TABLE=glue_catalog.zamboni_catalog.nonprod_registry
AUDIT_LOG_TABLE=glue_catalog.zamboni_catalog.audit_log
VACUUM_AUDIT_TABLE=glue_catalog.zamboni_catalog.vacuum_audit
CONTROLM_JOBS_TABLE=glue_catalog.zamboni_catalog.controlm_jobs

# ── Control Plane (SQLite-primary for config/control tables) ─────────────────
# stream_registry/hk_config/domain_registry/nonprod_registry/controlm_jobs
# read/write this file directly, not Athena -- see engine/core/
# control_plane.py. A bare filename here is fine for a laptop demo -- this
# runs from your working directory, never through CodeDeploy. On EC2, .env
# (from .env.example) MUST use the persistent /data/zamboni/zamboni_control.db
# path instead -- see the warning in .env.example for why a bare filename
# there would silently lose data on every deploy.
ZAMBONI_CONTROL_PLANE_DB=zamboni_control.db

# 2026-07-11 audit fix: if you intentionally delete/reset the local file
# above, scripts/init_control_plane_db.py will refuse to start against an
# empty DB with no S3 backup to restore -- set this true for that one
# rerun, then back to false. See .env.example for the full explanation.
ZAMBONI_CONTROL_PLANE_FIRST_INSTALL=false

# ── S3 Buckets ────────────────────────────────────────────────────────────────
STAGING_BUCKET=s3://your-staging-bucket
ARCHIVE_BUCKET=s3://your-archive-bucket
ZAMBONI_METADATA_BUCKET=s3://your-zamboni-metadata-bucket

# ── SNS ───────────────────────────────────────────────────────────────────────
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-west-2:123456789012:zamboni-alerts
SNS_GREENZONE_TOPIC_ARN=arn:aws:sns:us-west-2:123456789012:zamboni-greenzone

# ── CloudTrail (Lifecycle Engine activity signals, optional) ─────────────────
CLOUDTRAIL_TABLE=
CLOUDTRAIL_LOOKBACK_DAYS=90

# ── Maintenance Safety (Workstream A -- contracts.md §2, §3.1) ────────────────
# Defaults shown; override only if the demo needs a different floor/cap.
ORPHAN_MIN_AGE_HOURS_FLOOR=72
ORPHAN_DEFAULT_AGE_HOURS=96
SNAPSHOT_MIN_AGE_HOURS=24
MAX_ORPHAN_DELETE_PCT=20
CONFLICT_CACHE_TTL_HOURS=24
LOCK_TTL_MINUTES=120
LOCK_HEARTBEAT_SECONDS=60
GATE0_OVERRIDE_MAX_HOURS=24
DDB_LOCK_TABLE=zamboni_maintenance_locks

# ── Engine Behaviour ──────────────────────────────────────────────────────────
DRY_RUN_DEFAULT=true
LOG_LEVEL=INFO
MAX_CONCURRENT_PARTITIONS=10
CIRCUIT_BREAKER_THRESHOLD=3

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=dev
ZAMBONI_USER=demo-laptop
