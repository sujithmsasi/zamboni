# Zamboni -- Git line ending policy
# Ensures consistent line endings across Windows/Mac/Linux developers.

# Default: normalize all text files to LF in repo, checkout as-is on all platforms
* text=auto eol=lf

# Windows-specific scripts -- keep CRLF on Windows checkout
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.cmd   text eol=crlf

# Explicitly text files -- always LF
*.py    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.html  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.env   text eol=lf

# Binary files -- never touch line endings
*.db     binary
*.pyc    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.zip    binary
*.gz     binary
*.whl    binary
