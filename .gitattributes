# =============================================================================
# Zamboni — Git Attributes
# Ensures consistent line endings across Windows and Linux.
# All source files stored with LF in git.
# Windows users get CRLF on checkout (handled automatically by Git).
# =============================================================================

# Default — auto-detect text files
* text=auto

# Source code — always LF
*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.env   text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.whl   binary
*.pyc   binary
